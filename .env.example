# App URL (your Vercel deployment URL)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# WebSocket server URL (deployed separately on Railway/Render/etc.)
# Set in Vercel dashboard: Settings > Environment Variables
# NEXT_PUBLIC_WS_URL=https://your-ws-server.up.railway.app

# Redis — use REDIS_URL for Upstash (recommended for Vercel)
# Or REDIS_HOST + REDIS_PORT for local/self-hosted Redis
# REDIS_URL=rediss://:password@your-upstash-host.upstash.io:6380
# REDIS_HOST=localhost
# REDIS_PORT=6379
